{
  "expo": {
    "name": "conFusión",
//    "name": "conFusión 2026 Orriols-Benimaclet", // Por si Apple Store pide cambio de los metadatas
    "slug": "confusionapp",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.26.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#2d2219"
        }
      ],
      "expo-font",
       [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "GOOGLE_MAPS_API_KEY",
          "androidGoogleMapsApiKey": "GOOGLE_MAPS_API_KEY"
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.beniconfusionfest.confusionapp", // cambiamos el bundleIdentifier y aparecerá como una app nueva en la App Store
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mostraremos tu localización en los mapas para que ubiques los espacios más fácilmente",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "20"
    },
    "android": {
      "package": "es.beniconfusionfest.confusion", // mismo como todos los años para que no haya problemas con las actualizaciones
      "permissions": [
        "INTERNET",
        "WRITE_SETTINGS",
        "ACCESS_FINE_LOCATION"
      ],
      "versionCode": 26
    },
    "extra": {
      "eas": {
//        "projectId": "3713b59a-b78e-40c8-bf96-f2e9834e5a34"  // Pietro eas account
        "projectId": "728863cd-f38c-4412-a4fa-befa5bbb9696"
      }
    }
  }
}
